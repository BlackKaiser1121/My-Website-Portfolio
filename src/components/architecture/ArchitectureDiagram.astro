---
import type { ArchitecturePreview } from "../../types/portfolio";

interface Props {
  preview: ArchitecturePreview;
}

const { preview } = Astro.props;
---

<figure class="architecture-diagram" aria-labelledby="architecture-diagram-title">
  <figcaption id="architecture-diagram-title">{preview.textAlternative}</figcaption>
  <ol class="architecture-diagram__nodes">
    {
      preview.nodes.map((node) => (
        <li>
          <span>{node.label}</span>
          <p>{node.detail}</p>
        </li>
      ))
    }
  </ol>
</figure>
