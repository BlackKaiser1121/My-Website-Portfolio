---
import { navigationItems } from "../../data/navigation";
---

<nav class="site-nav" aria-label="Primary" data-site-nav data-nav-state="open">
  <a class="site-nav__mark" href="./" aria-current="page">Jared Baquirin</a>
  <button
    class="site-nav__toggle"
    type="button"
    aria-label="Open navigation"
    aria-expanded="false"
    aria-controls="primary-navigation-menu"
    data-nav-toggle
  >
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
  <ul id="primary-navigation-menu" class="site-nav__list" data-nav-menu>
    {
      navigationItems.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import "../../scripts/navigation";
</script>
